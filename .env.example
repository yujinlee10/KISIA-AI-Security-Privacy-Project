# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿 (이 파일은 커밋됩니다. 실제 값은 넣지 마세요)
#
# 사용법: 프로젝트 루트에서
#   cp .env.example .env
# 한 뒤 .env에 값을 채웁니다. .env는 .gitignore에 등록되어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# [필수] monogpt 접속 정보
# fuzzer/.env(한재이 파트)와 같은 값을 넣으면 Fuzzer·Target·Extractor가 같은 모델을 씁니다.
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# [선택] 비워두면 core/config.py의 기본값을 씁니다
# LLM_MAX_TOKENS=1200
# LLM_TIMEOUT_SEC=60
# LLM_MAX_RETRIES=3
# LLM_MIN_INTERVAL_SEC=0
